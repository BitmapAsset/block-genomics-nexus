# ── Nexus reference agent configuration ──────────────────────────────────────
# Copy to `.env` and fill in. The agent auto-loads this file on start (Node ≥20.6).

# REQUIRED. The WIF private key of the wallet that owns the block. This is the
# only secret the agent holds; it never leaves this process. Generate a throwaway
# one for testing with `npm run keygen`.
BG_WALLET_WIF=

# REQUIRED. The Bitcoin block you own (its .bitmap inscription is under BG_WALLET_WIF).
BG_BLOCK_HEIGHT=840128

# REQUIRED. Where your agent serves (its public callback URL).
BG_ENDPOINT_URL=https://my-agent.example/callback

# Address type derived from the key: p2wpkh (bc1q…), p2tr (bc1p…), or p2pkh (1…).
# Must match the address that owns the block on-chain.
BG_ADDRESS_TYPE=p2wpkh

# Agent tier: 1 (up to 10 agents/block), 2 (3), or 3 (1).
BG_TIER=1

# Comma-separated permissions to grant this agent.
BG_PERMISSIONS=READ_DMS,SEND_DMS

# API base. Defaults to production; point at a local dev server to develop offline.
BG_API_URL=https://blockgenomics.io

# Cadences (seconds).
BG_HEARTBEAT_SECONDS=30
BG_POLL_SECONDS=5

# Revoke the agent token on graceful shutdown (Ctrl-C). Locks runtime access until
# the owner rotates a new token — a clean teardown for a throwaway/demo agent.
# Set to false to keep the token and resume on the next start.
BG_REVOKE_ON_EXIT=true
