// =============================================================================
// Block Genomics — Verified Claims: Prisma Schema Additions
// These models extend the existing schema in database/prisma/schema.prisma
// =============================================================================

// =============================================================================
// NEW ENUMS
// =============================================================================

/// The type of real-world anchor being claimed
enum ClaimType {
  EMAIL
  TWITTER
  DOMAIN
  NOSTR
  API_ENDPOINT
  SIGNING_KEY
}

/// Lifecycle status of a verified claim
enum ClaimStatus {
  /// Challenge issued, awaiting proof submission
  PENDING_VERIFICATION
  /// Proof submitted, undergoing async validation
  PROCESSING
  /// Claim verified and active
  ACTIVE
  /// Verification failed (proof invalid, expired, etc.)
  FAILED
  /// Claim expired — needs re-verification to reactivate
  EXPIRED
  /// Claim revoked by the owner
  REVOKED
  /// Claim suspended by admin (abuse, dispute, etc.)
  SUSPENDED
}

// =============================================================================
// VERIFIED CLAIM — A real-world anchor attached to an agent's genome
// =============================================================================

model VerifiedClaim {
  id               String      @id @default(cuid())

  /// The agent (genome holder) who owns this claim
  agentId          String

  /// Type of claim (EMAIL, TWITTER, DOMAIN, etc.)
  claimType        ClaimType

  /// The claimed value (email address, @handle, domain name, npub, URL, etc.)
  /// Stored normalized: lowercase for email/domain, without @ for twitter
  claimValue       String

  /// Human-readable display value (preserves original casing, formatting)
  displayValue     String

  /// Current status of this claim
  status           ClaimStatus @default(PENDING_VERIFICATION)

  /// When the current verification was completed
  verifiedAt       DateTime?

  /// When this claim expires and needs re-verification
  expiresAt        DateTime?

  /// When this claim was revoked (if applicable)
  revokedAt        DateTime?

  /// Reason for revocation or failure
  statusReason     String?

  /// Challenge nonce for the current/last verification attempt
  /// 32-char hex string, cryptographically random
  challengeNonce   String?     @db.Char(32)

  /// When the current challenge expires (typically 10-30 minutes)
  challengeExpiresAt DateTime?

  /// JSON blob of challenge-specific data (e.g., email code, DNS record value)
  challengeData    Json?

  /// How many times this claim has been successfully verified
  verificationCount Int        @default(0)

  /// How many consecutive re-verification failures
  failureStreak    Int         @default(0)

  /// Whether this claim is publicly visible on the agent's profile
  isPublic         Boolean     @default(true)

  /// Whether this is the primary claim of its type (e.g., primary email)
  isPrimary        Boolean     @default(false)

  /// Metadata: JSON blob for type-specific data
  /// Email: { provider: "gmail" }
  /// Twitter: { followersCount: 1234, accountCreatedAt: "..." }
  /// Domain: { registrar: "cloudflare", dnssecEnabled: true }
  /// Nostr: { relays: ["wss://..."] }
  /// API: { methods: ["GET"], healthCheckUrl: "..." }
  metadata         Json        @default("{}")

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // --- Relations ---
  agent            Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  proofs           ClaimProof[]
  attempts         VerificationAttempt[]

  // --- Constraints ---
  // An agent can only have one active claim per (type, value) pair
  @@unique([agentId, claimType, claimValue])

  @@index([agentId])
  @@index([claimType])
  @@index([claimValue])
  @@index([status])
  @@index([expiresAt])
  @@index([claimType, claimValue])  // reverse lookup: "who owns example.com?"
  @@map("verified_claims")
}

// =============================================================================
// CLAIM PROOF — Cryptographic evidence for a verified claim
// =============================================================================

model ClaimProof {
  id             String   @id @default(cuid())

  /// The claim this proof belongs to
  claimId        String

  /// Type of proof evidence
  /// "email_code"       — The code that was sent and confirmed
  /// "oauth_token"      — OAuth access token hash (NOT the token itself)
  /// "dns_txt_record"   — The DNS TXT record value found
  /// "nostr_event"      — Signed Nostr event JSON
  /// "http_challenge"   — Challenge-response from API endpoint
  /// "signature"        — Cryptographic signature over challenge
  /// "screenshot"       — Screenshot evidence (for manual review)
  proofType      String

  /// The proof data itself — structure depends on proofType
  /// Sensitive tokens are stored as SHA-256 hashes, never raw
  proofData      Json

  /// SHA-256 hash of the canonical proof for integrity verification
  proofHash      String   @db.Char(64)

  /// The challenge nonce this proof responds to (binds proof to challenge)
  challengeNonce String   @db.Char(32)

  /// Whether this proof was cryptographically validated
  isValid        Boolean  @default(false)

  /// The agent's genome hash at time of proof (detects genome changes)
  genomeAtProof  String   @db.Char(64)

  /// Optional: Bitcoin block height at time of proof (temporal anchor)
  blockHeightAtProof Int?

  /// Optional: TXID if proof was anchored on-chain
  onChainTxId    String?

  createdAt      DateTime @default(now())

  // --- Relations ---
  claim          VerifiedClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([proofHash])
  @@index([onChainTxId])
  @@map("claim_proofs")
}

// =============================================================================
// VERIFICATION ATTEMPT — Audit log for every verification attempt
// =============================================================================

model VerificationAttempt {
  id             String    @id @default(cuid())

  /// The claim being verified
  claimId        String

  /// What triggered this attempt: "initial", "re_verification", "manual", "refresh"
  trigger        String

  /// Whether the attempt succeeded
  success        Boolean

  /// Error message if failed
  errorMessage   String?

  /// Error code for programmatic handling
  errorCode      String?

  /// IP address of the requester (for rate limiting and abuse detection)
  ipAddress      String?

  /// User agent string (for abuse detection)
  userAgent      String?

  /// How long the verification took (milliseconds)
  durationMs     Int?

  /// Snapshot of the proof data at time of attempt
  attemptData    Json?

  createdAt      DateTime  @default(now())

  // --- Relations ---
  claim          VerifiedClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([success])
  @@index([createdAt])
  @@index([ipAddress])
  @@map("verification_attempts")
}

