generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_POSTGRES_URL_NON_POOLING")
}

model User {
  walletAddress String   @id @unique
  handle        String?  @unique
  displayName   String?
  bio           String?
  avatar        String?
  genomeHash    String?
  anchorBlock   Int?     // The block/parcel they verified ownership of
  tier          Int      @default(3) // 1=Block Owner, 2=Parcel Owner, 3=Delegated
  verified      Boolean  @default(false)
  encryptionPubKey String? // secp256k1 public key (hex) for E2E encrypted DMs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  blocks                Block[]
  parcels               Parcel[]
  delegationsOwned      Delegation[]        @relation("DelegationOwner")
  delegationsReceived   Delegation[]        @relation("DelegationDelegatee")
  delegationListings    DelegationListing[]
  chatMessages          ChatMessage[]
  estates               Estate[]
  sessions              UserSession[]
  activities            ActivityLog[]
}

model Block {
  height       Int      @id @unique
  hash         String?
  ownerAddress String?
  label        String?
  groundColor  String?  @default("#2d5a27")
  skyColor     String?  @default("#87CEEB")
  inscriptionId  String?   // The .bitmap inscription ID for on-chain verification
  lastOwnerCheck DateTime? // When we last verified on-chain ownership
  createdAt      DateTime @default(now())

  owner                User?               @relation(fields: [ownerAddress], references: [walletAddress])
  parcels              Parcel[]
  delegations          Delegation[]
  delegationListings   DelegationListing[]
  chatMessages         ChatMessage[]
  estates              Estate[]

  @@index([ownerAddress])
}

model Parcel {
  blockHeight  Int
  txIndex      Int
  ownerAddress String?
  customColor  String?
  pattern      String?
  imageUrl     String?
  rotation     Float?   @default(0)
  facing       String?  @default("north")
  emissive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  block Block @relation(fields: [blockHeight], references: [height])
  owner User? @relation(fields: [ownerAddress], references: [walletAddress])

  @@id([blockHeight, txIndex])
  @@unique([blockHeight, txIndex])
  @@index([ownerAddress])
}

model Delegation {
  id               String   @id @default(cuid())
  blockHeight      Int
  parcelTxIndex    Int?
  ownerAddress     String
  delegateeAddress String
  tier             Int      // 2 or 3
  durationDays     Int      // 30 or 365
  priceSats        Int
  protocolFeeSats  Int
  startDate        DateTime
  endDate          DateTime
  active           Boolean  @default(true)
  txId             String?
  createdAt        DateTime @default(now())

  block    Block @relation(fields: [blockHeight], references: [height])
  owner    User  @relation("DelegationOwner", fields: [ownerAddress], references: [walletAddress])
  delegatee User @relation("DelegationDelegatee", fields: [delegateeAddress], references: [walletAddress])

  @@index([blockHeight])
  @@index([ownerAddress])
  @@index([delegateeAddress])
  @@index([active])
}

model DelegationListing {
  id            String   @id @default(cuid())
  blockHeight   Int
  parcelTxIndex Int?
  ownerAddress  String
  tier          Int      // 2 or 3
  spotsTotal    Int      @default(-1) // -1 = unlimited
  spotsUsed     Int      @default(0)
  price30d      Int      // sats for 30 days
  price365d     Int      // sats for 365 days
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  block Block @relation(fields: [blockHeight], references: [height])
  owner User  @relation(fields: [ownerAddress], references: [walletAddress])

  @@index([blockHeight])
  @@index([ownerAddress])
  @@index([active])
}

model ChatMessage {
  id            String   @id @default(cuid())
  blockHeight   Int
  senderAddress String
  senderHandle  String?
  text          String
  type          String   @default("text") // text, image, gif, link
  channel       String   @default("block") // block, dm, global
  mediaUrl      String?
  replyToId     String?
  reported      Boolean  @default(false)
  createdAt     DateTime @default(now())

  block  Block @relation(fields: [blockHeight], references: [height])
  sender User  @relation(fields: [senderAddress], references: [walletAddress])

  @@index([blockHeight])
  @@index([senderAddress])
  @@index([createdAt])
}

model HandleHistory {
  id            String   @id @default(cuid())
  handle        String
  walletAddress String
  action        String   // "claimed" | "released" | "changed"
  createdAt     DateTime @default(now())

  @@index([handle])
  @@index([walletAddress])
}

model Estate {
  id            String   @id @default(cuid())
  name          String
  ownerAddress  String
  blockHeight   Int
  parcelIndices String   // JSON array of ints (SQLite doesn't support Int[])
  glowColor     String?
  createdAt     DateTime @default(now())

  block Block @relation(fields: [blockHeight], references: [height])
  owner User  @relation(fields: [ownerAddress], references: [walletAddress])

  @@index([blockHeight])
  @@index([ownerAddress])
}

// ─── Bitmap Agent Protocol ───────────────────────────────────────

model BitmapAgent {
  id            String   @id @default(cuid())
  walletAddress String
  endpointUrl   String
  blockHeight   Int
  parcelIndex   Int?
  tier          Int      @default(3) // 1=Block Owner, 2=Parcel, 3=Delegated
  permissions   String   // JSON array of AgentPermission strings
  status        String   @default("active") // active | inactive | revoked | suspended
  createdAt     DateTime @default(now())
  lastHeartbeat DateTime @default(now())

  events   AgentEvent[]
  briefs   AgentBrief[]
  sessions AgentSession[]

  @@index([walletAddress])
  @@index([blockHeight])
  @@index([status])
}

model AgentEvent {
  id        String   @id @default(cuid())
  agentId   String
  type      String   // visitor_arrived | dm_received | offer_made | content_reported | permission_request | heartbeat
  payload   String   // JSON
  timestamp DateTime @default(now())

  agent BitmapAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([type])
  @@index([timestamp])
}

model AgentBrief {
  id                 String   @id @default(cuid())
  agentId            String
  period             String   // ISO interval
  summary            String
  stats              String   // JSON { visitors, dms, offers, actions }
  pendingPermissions String   // JSON array
  createdAt          DateTime @default(now())

  agent BitmapAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([createdAt])
}

model VPSLink {
  id              String   @id @default(cuid())
  walletAddress   String
  blockHeight     Int
  parcelIndex     Int?
  serverUrl       String
  connectionType  String   @default("https") // https | websocket | webrtc
  status          String   @default("linked") // linked | unlinked | unhealthy
  tlsVerified     Boolean  @default(false)
  lastHealthCheck DateTime?
  createdAt       DateTime @default(now())

  @@index([walletAddress])
  @@index([blockHeight])
  @@index([status])
}

model AgentSession {
  id          String   @id @default(cuid())
  agentId     String
  bitmapAddr  String
  sandboxId   String   @unique
  permissions String   // JSON array
  activityLog String   @default("[]") // JSON array
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  agent BitmapAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([sandboxId])
}

// ─── Enterprise Data Infrastructure ─────────────────────────────

model UserSession {
  id             String    @id @default(cuid())
  walletAddress  String
  walletType     String
  ipHash         String?
  userAgent      String?
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  lastActiveAt   DateTime  @default(now())
  user           User      @relation(fields: [walletAddress], references: [walletAddress])

  @@index([walletAddress])
}

model ActivityLog {
  id            String   @id @default(cuid())
  walletAddress String
  action        String
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [walletAddress], references: [walletAddress])

  @@index([walletAddress])
  @@index([action])
  @@index([createdAt])
}

model PageView {
  id            String   @id @default(cuid())
  path          String
  walletAddress String?
  sessionId     String?
  referrer      String?
  createdAt     DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model ProfileView {
  id            String   @id @default(cuid())
  viewedHandle  String
  viewerAddress String?
  createdAt     DateTime @default(now())

  @@index([viewedHandle])
  @@index([createdAt])
}

model SearchLog {
  id            String   @id @default(cuid())
  query         String
  resultsCount  Int      @default(0)
  walletAddress String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model ContentFlag {
  id          String   @id @default(cuid())
  contentType String   // 'chat_message' | 'parcel_content' | 'profile' | 'estate'
  contentId   String   // ID of the flagged content
  flaggedBy   String   // Wallet address of flagger
  isBrainFlag Boolean  @default(false) // true if flagged by Nexus Brain AI
  reason      String?  // Optional reason
  ruleIndex   Int?     // Which moral rule (0-4) was violated, if applicable
  createdAt   DateTime @default(now())

  @@unique([contentId, flaggedBy])
  @@index([contentId])
  @@index([flaggedBy])
}

model ContentVerdict {
  id          String   @id @default(cuid())
  contentType String
  contentId   String   @unique
  status      String   @default("visible") // 'visible' | 'hidden' | 'permanent_hide' | 'restored'
  flagCount   Int      @default(0)
  hiddenAt    DateTime?
  restoredAt  DateTime?
  appealId    String?
  auditLog    String?  // JSON array of actions taken
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contentId])
  @@index([status])
}

model Appeal {
  id           String   @id @default(cuid())
  contentId    String
  appealedBy   String   // Wallet address of content owner
  reason       String?
  votesFor     Int      @default(0) // Votes to restore
  votesAgainst Int      @default(0) // Votes to keep hidden
  voters       String?  // JSON array of wallet addresses who voted
  status       String   @default("pending") // 'pending' | 'restored' | 'upheld'
  expiresAt    DateTime
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([contentId])
  @@index([status])
}

model BrainAction {
  id         String   @id @default(cuid())
  actionType String   // 'flag' | 'scan' | 'alert' | 'threshold_hide'
  contentId  String?
  details    String?  // JSON details
  txHash     String?  // Bitcoin tx if fee-related
  createdAt  DateTime @default(now())

  @@index([actionType])
  @@index([createdAt])
}

model FlagStrike {
  id            String   @id @default(cuid())
  walletAddress String
  strikeCount   Int      @default(1)
  lastStrikeAt  DateTime @default(now())
  suspended     Boolean  @default(false)
  suspendedAt   DateTime?

  @@unique([walletAddress])
}

// ─── Guardian Shell Agent System ─────────────────────────────────

model GuardianAgent {
  id            String   @id @default(cuid())
  blockHeight   Int
  ownerAddress  String

  // Soul & Identity
  name          String
  soulMd        String   @db.Text
  agentMd       String?  @db.Text
  skillsMd      String?  @db.Text
  memoryMd      String?  @db.Text
  personality   String?  @db.Text

  // BYOK LLM Config
  llmProvider   String?
  llmModel      String?
  llmApiKey     String?
  llmEndpoint   String?

  // Self-hosted option
  selfHosted       Boolean  @default(false)
  agentEndpoint    String?
  endpointVerified Boolean  @default(false)
  lastHeartbeat    DateTime?

  // Auto-responses (JSON array of {trigger, response})
  autoResponses String? @db.Text

  // Escalation config
  escalateTelegram          String?
  escalateEmail             String?
  autoApproveDelegationUnder Int?

  // Protocol
  protocolVersion String?  @default("1.0.0")
  configJson      String?  @db.Text

  // Status
  status        String   @default("active")
  totalVisitors Int      @default(0)
  totalMessages Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blockHeight, ownerAddress])
  @@index([blockHeight])
  @@index([ownerAddress])
}

model GuardianConversation {
  id             String   @id @default(cuid())
  guardianId     String
  visitorAddress String?
  visitorHandle  String?
  messages       String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([guardianId])
}

// ─── World-Building System ─────────────────────────────────────

model BlockObject {
  id            String   @id @default(cuid())
  blockHeight   Int
  ownerAddress  String

  objectType    String
  name          String?

  posX          Float    @default(0)
  posY          Float    @default(0)
  posZ          Float    @default(0)
  rotX          Float    @default(0)
  rotY          Float    @default(0)
  rotZ          Float    @default(0)
  scaleX        Float    @default(1)
  scaleY        Float    @default(1)
  scaleZ        Float    @default(1)

  geometry      String?
  geoParams     String?  @db.Text

  color         String?  @default("#f7931a")
  emissive      String?
  emissiveIntensity Float? @default(0)
  metalness     Float?   @default(0.5)
  roughness     Float?   @default(0.5)
  opacity       Float?   @default(1)
  transparent   Boolean  @default(false)
  textureUrl    String?

  lightType     String?
  lightIntensity Float?
  lightDistance  Float?
  lightColor    String?

  text3d        String?
  fontSize      Float?

  soundUrl      String?
  soundVolume   Float?
  soundRadius   Float?
  soundLoop     Boolean? @default(true)

  effectType    String?
  effectParams  String?  @db.Text

  interactive   Boolean  @default(false)
  clickAction   String?
  clickData     String?

  visible       Boolean  @default(true)
  locked        Boolean  @default(false)
  layer         String?  @default("default")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([blockHeight])
}

model BlockTerrain {
  id            String   @id @default(cuid())
  blockHeight   Int      @unique
  ownerAddress  String

  groundColor   String?  @default("#1a1a1a")
  groundTexture String?
  groundMetalness Float? @default(0)
  groundRoughness Float? @default(0.8)

  fogEnabled    Boolean  @default(false)
  fogColor      String?  @default("#0a0a0f")
  fogNear       Float?   @default(50)
  fogFar        Float?   @default(300)

  skyColor      String?  @default("#0a0a0f")
  skyEnabled    Boolean  @default(false)

  ambientColor  String?  @default("#ffeedd")
  ambientIntensity Float? @default(0.35)

  weather       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GuardianEvent {
  id         String   @id @default(cuid())
  guardianId String
  eventType  String
  data       String?  @db.Text
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([guardianId])
  @@index([eventType])
}

// ─── Game Logic Layer ────────────────────────────────────────────

model GameElement {
  id            String   @id @default(cuid())
  blockHeight   Int
  ownerAddress  String
  objectId      String?

  gameType      String
  subType       String?

  rewardType    String?
  rewardAmount  Int?     @default(0)
  rewardData    String?  @db.Text

  triggerType   String?
  triggerRadius Float?   @default(2)
  triggerData   String?  @db.Text

  respawnMs     Int?
  maxClaims     Int?
  claimCount    Int      @default(0)

  icon          String?
  label         String?
  color         String?
  glowColor     String?
  animation     String?
  particleEffect String?

  posX          Float    @default(0)
  posY          Float    @default(0)
  posZ          Float    @default(0)

  enabled       Boolean  @default(true)
  visible       Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([blockHeight])
  @@index([objectId])
}

model GameState {
  id            String   @id @default(cuid())
  blockHeight   Int
  walletAddress String

  score         Int      @default(0)
  xp            Int      @default(0)
  level         Int      @default(1)
  coins         Int      @default(0)

  collected     String?  @db.Text
  questProgress String?  @db.Text
  achievements  String?  @db.Text
  inventory     String?  @db.Text

  totalTimeMs   Int      @default(0)
  lastVisit     DateTime @default(now())

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([blockHeight, walletAddress])
  @@index([blockHeight])
  @@index([walletAddress])
}

model GameLeaderboard {
  id            String   @id @default(cuid())
  blockHeight   Int
  walletAddress String
  handle        String?

  category      String   @default("score")
  value         Int      @default(0)
  metadata      String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([blockHeight, walletAddress, category])
  @@index([blockHeight, category, value])
}

model OwnershipTransfer {
  id              String   @id @default(cuid())
  blockHeight     Int
  inscriptionId   String?
  previousOwner   String
  newOwner        String

  buildingsKept   Boolean  @default(true)
  guardiansKept   Boolean  @default(true)
  guardiansPaused Boolean  @default(true)

  detectedAt      DateTime @default(now())

  @@index([blockHeight])
  @@index([previousOwner])
  @@index([newOwner])
}

model GameQuest {
  id            String   @id @default(cuid())
  blockHeight   Int
  ownerAddress  String

  name          String
  description   String?  @db.Text
  icon          String?

  steps         String   @db.Text

  rewardType    String?
  rewardAmount  Int?
  rewardData    String?  @db.Text

  crossBlock    Boolean  @default(false)
  blockList     String?  @db.Text

  maxCompletions Int?
  completionCount Int    @default(0)

  enabled       Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([blockHeight])
}
