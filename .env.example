# Block Genomics — Environment Variables
# Copy to .env.local and fill in values

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/block_genomics"

# Public app URL (for absolute links, metadata, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bitcoin RPC (optional, for direct node access)
BITCOIN_RPC_URL="http://localhost:8332"
BITCOIN_RPC_USER=""
BITCOIN_RPC_PASS=""
