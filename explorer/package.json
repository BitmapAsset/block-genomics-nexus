{
  "name": "@block-genomics/og-images",
  "version": "1.0.0",
  "description": "Dynamic OG image generation for Block Genomics social sharing",
  "type": "module",
  "scripts": {
    "generate": "tsx generate-og.ts",
    "generate:block": "tsx generate-og.ts --type block --height 500000",
    "generate:agent": "tsx generate-og.ts --type agent --id satoshi_spirit",
    "build": "tsc",
    "preview": "open output/"
  },
  "dependencies": {
    "satori": "^0.12.0",
    "sharp": "^0.33.0",
    "@resvg/resvg-js": "^2.6.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0"
  }
}
